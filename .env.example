# Copy to .env and fill in before running `docker compose up`.

# Selects the deployment mode described in docs/design/master-prompt.md §1, §8.
# Gates nws-poller, remote STT, LiteLLM enrichment, and Meshtastic MQTT
# fallback -- offgrid disables all four and the system stays fully
# functional.
TOCSIN_MODE=offgrid

POSTGRES_PASSWORD=changeme

# RTL-SDR dongle(s), addressed by serial number: site:serial,site2:serial2.
# Find serials with `make sdr-devices` once the dongle is plugged in and the
# host prerequisites (README "Hardware bring-up") are done. Leave unset and
# sdr-rx reports that and exits cleanly rather than failing.
SDR_RX_DEVICES=

# Must match <source-password> in deploy/icecast/icecast.xml. Change both
# before exposing Icecast's port past localhost.
ICECAST_SOURCE_PASSWORD=hackme

# Seeds whisper.cpp's --prompt with local place/county names -- design doc
# §6: NWR's synthesized voices fail almost exclusively on proper nouns.
# Requires `make fetch-models` first; see services/stt_worker/README.md.
STT_WORKER_INITIAL_PROMPT=
