# Copy to .env and edit. Everything here has a working default except
# POSTGRES_PASSWORD. For the reasoning behind any variable, see the README
# of the service that reads it (services/<name>/README.md).


# ── Core ────────────────────────────────────────────────────────────────

# offgrid: no network dependency anywhere. hybrid additionally enables
# nws-poller, remote STT, LiteLLM enrichment, and the Meshtastic MQTT
# fallback -- see the "Hybrid only" section at the bottom.
TOCSIN_MODE=offgrid

# Set this before the FIRST `up`. Postgres stores it when it initializes
# the timescale-data volume and ignores later changes -- see the README's
# Troubleshooting section. Any characters are fine; api URL-encodes them.
POSTGRES_PASSWORD=changeme

# Which compose files make up the stack. To run with no Meshtastic node
# attached, drop the overlay: COMPOSE_FILE=compose.yaml -- the whole
# receive side still works. See services/dispatcher/README.md.
COMPOSE_FILE=compose.yaml:compose.mesh.yaml


# ── Ports (see README "Ports") ──────────────────────────────────────────

# Web UI and API: http://<host>:8080/
TOCSIN_WEB_PORT=8080

# Icecast: http://<host>:8000/<site>-<channel>.ogg. Must stay above 1024.
ICECAST_PORT=8000

# Only for an Icecast behind a reverse proxy; unset means the browser uses
# this page's own hostname on ICECAST_PORT.
ICECAST_PUBLIC_URL=

# uvicorn's bind port *inside* the api container -- never appears in a URL
# you type, so rarely worth changing.
API_PORT=8000


# ── Radio (see services/sdr_rx/README.md, README "Hardware bring-up") ───

# RTL-SDR dongles as site:serial,site2:serial2. Find serials with
# `make sdr-devices`. Unset means sdr-rx says so and exits cleanly.
SDR_RX_DEVICES=

# Manual gain in dB, never AGC. Raise it if SAME headers never decode
# despite audible audio; lower it if the UI's spectrum bins look saturated.
SDR_RX_GAIN_DB=30

# Must match <source-password> in deploy/icecast/icecast.xml. Change both
# before exposing Icecast past localhost.
ICECAST_SOURCE_PASSWORD=hackme


# ── Transcription (see services/stt_worker/README.md) ───────────────────

# Model to load from ./models/. Stage it with `make fetch-models` while
# network is available; if you fetch something other than base.en, name it
# here. stt-worker waits for the file rather than failing.
STT_WORKER_MODEL_FILE=ggml-base.en.bin

# Local place and county names -- NWR's synthesized voices fail almost
# exclusively on proper nouns.
STT_WORKER_INITIAL_PROMPT=


# ── Meshtastic (see services/dispatcher/README.md) ──────────────────────

# serial (USB) or tcp (a node on your LAN, still valid offgrid). A tcp
# node needs no device mapping: set COMPOSE_FILE=compose.yaml above and
# MESHTASTIC_ENABLED=true here.
MESHTASTIC_TRANSPORT=serial

# serial: host device path, mapped into dispatcher by compose.mesh.yaml.
MESHTASTIC_SERIAL_DEVICE=/dev/ttyUSB0

# tcp: the node's address and network API port.
MESHTASTIC_TCP_HOST=
MESHTASTIC_TCP_PORT=4403


# ── Hybrid only (all ignored under TOCSIN_MODE=offgrid) ─────────────────

# api.weather.gov requires a descriptive User-Agent identifying the caller.
# nws-poller refuses to start without one.
NWS_POLLER_USER_AGENT=tocsin (youremail@example.com)

# States and marine areas to poll, comma-separated.
NWS_POLLER_AREAS=OR,WA

# `local,remote` races a remote OpenAI-compatible transcription endpoint
# against local whisper.cpp on Tier A captures.
STT_CHAIN=local
STT_WORKER_REMOTE_BASE_URL=
STT_WORKER_REMOTE_API_KEY=
STT_WORKER_REMOTE_MODEL=whisper-1

# Stage-2 alert enrichment against a LiteLLM proxy or any OpenAI-compatible
# /chat/completions endpoint. Unset means stage 2 is skipped entirely.
DISPATCHER_LITELLM_BASE_URL=
DISPATCHER_LITELLM_API_KEY=
DISPATCHER_LITELLM_MODEL=gpt-4o-mini

# MQTT fallback: decimal node ID of the node that relays MQTT-injected
# messages onto the mesh. That node needs a channel literally named "mqtt"
# with downlink enabled.
MESHTASTIC_GATEWAY_NODE_ID=
