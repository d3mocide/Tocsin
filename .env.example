# Copy to .env and fill in before running `docker compose up`.

# Selects the deployment mode described in docs/design/master-prompt.md §1, §8.
# Gates nws-poller, remote STT, LiteLLM enrichment, and Meshtastic MQTT
# fallback -- offgrid disables all four and the system stays fully
# functional.
TOCSIN_MODE=offgrid

POSTGRES_PASSWORD=changeme

# Host port for the web UI (and the API behind it, same origin) -- change
# this if 8080 is already taken on the machine running the stack. The
# bring-up runbook in README.md assumes the default.
TOCSIN_WEB_PORT=8080

# Port uvicorn binds *inside* the api container. Only worth changing if
# something in a custom overlay collides with it; compose maps
# TOCSIN_WEB_PORT to whatever this is, so the URL you browse to is the one
# above either way.
API_PORT=8000

# Icecast's port, used three ways at once and therefore a single knob: the
# port Icecast listens on inside its container, the port compose publishes
# on the host, and the port live-audio and api dial to push/read streams.
# It is also the port the browser falls back to when ICECAST_PUBLIC_URL is
# unset, which is why the host and container sides are not separable here.
# Must stay above 1024 -- Icecast runs unprivileged (deploy/icecast/Dockerfile).
ICECAST_PORT=8000

# Where the *browser* should reach Icecast, for deployments where that
# isn't "this page's hostname on ICECAST_PORT" -- a reverse proxy in
# front of it, typically. Unset is right for the usual "browse to the Pi
# on the LAN" case.
ICECAST_PUBLIC_URL=

# RTL-SDR dongle(s), addressed by serial number: site:serial,site2:serial2.
# Find serials with `make sdr-devices` once the dongle is plugged in and the
# host prerequisites (README "Hardware bring-up") are done. Leave unset and
# sdr-rx reports that and exits cleanly rather than failing.
SDR_RX_DEVICES=

# Manual RTL-SDR gain in dB (design doc §3: auto gain oscillates on a
# constant carrier, so this stays manual, not AGC). 30 dB is a starting
# point for a typical setup -- raise it if same-decoder never sees a
# clean SAME header despite audible audio (weak signal), lower it if the
# 41 spectrum-only bins in the web UI look saturated/clipped (too hot).
SDR_RX_GAIN_DB=30

# Must match <source-password> in deploy/icecast/icecast.xml. Change both
# before exposing Icecast's port past localhost.
ICECAST_SOURCE_PASSWORD=hackme

# Seeds whisper.cpp's --prompt with local place/county names -- design doc
# §6: NWR's synthesized voices fail almost exclusively on proper nouns.
# Requires `make fetch-models` first; see services/stt_worker/README.md.
STT_WORKER_INITIAL_PROMPT=

# hybrid-only (nws-poller doesn't run under offgrid, so this is only read
# there). api.weather.gov requires a descriptive User-Agent identifying
# the calling application -- nws-poller refuses to start without it.
NWS_POLLER_USER_AGENT=tocsin (youremail@example.com)

# States/marine areas to poll, comma-separated -- see services/nws_poller/README.md.
# Default covers fips.csv's seeded Portland, OR WFO area (data/README.md).
NWS_POLLER_AREAS=OR,WA

# Which compose files make up the stack. compose.mesh.yaml maps the
# Meshtastic serial device and turns on the transmit path; it is included
# by default because relaying to the mesh is the point of the project.
#
# *** To run without a Meshtastic node attached, drop it: ***
#     COMPOSE_FILE=compose.yaml
#
# Everything on the receive side -- SAME decode, transcription, the alert
# log, the web UI -- works with no radio attached; dispatcher still runs
# stage 1 in full and records what it would have transmitted. Docker
# refuses to start a container whose device path is missing from the host,
# which is why this is a file to drop rather than a flag to flip.
COMPOSE_FILE=compose.yaml:compose.mesh.yaml

# How dispatcher reaches the Meshtastic node: serial (USB) or tcp (a node
# on your network, over WiFi/Ethernet) -- design doc §7 supports both.
#
# For a NETWORKED node, set all three of these and drop compose.mesh.yaml
# from COMPOSE_FILE above -- there is no USB device to map, so the overlay
# is unnecessary and MESHTASTIC_ENABLED has to be turned on by hand:
#     COMPOSE_FILE=compose.yaml
#     MESHTASTIC_ENABLED=true
#     MESHTASTIC_TRANSPORT=tcp
#     MESHTASTIC_TCP_HOST=192.168.1.50
# The node must have its network API reachable on MESHTASTIC_TCP_PORT
# (4403 is the Meshtastic default). This is a LAN link, not an internet
# one, so it stays valid in offgrid mode.
MESHTASTIC_TRANSPORT=serial
MESHTASTIC_TCP_HOST=
MESHTASTIC_TCP_PORT=4403

# Host serial device for a USB-attached Meshtastic node. Only read when
# compose.mesh.yaml is in COMPOSE_FILE above (and ignored entirely when
# MESHTASTIC_TRANSPORT=tcp). With a node configured but not attached,
# dispatcher fails loudly at startup and retries under restart: on-failure
# (see services/dispatcher/README.md).
MESHTASTIC_SERIAL_DEVICE=/dev/ttyUSB0

# hybrid-only: MQTT fallback (design doc §7) is only ever attempted under
# TOCSIN_MODE=hybrid, and only if this is set -- the decimal node ID of
# the Meshtastic node that will relay MQTT-injected messages onto the
# mesh. Requires that node to have a channel literally named "mqtt" with
# downlink enabled; see services/dispatcher/README.md.
MESHTASTIC_GATEWAY_NODE_ID=

# hybrid-only: base URL for a LiteLLM proxy or any OpenAI-compatible
# /chat/completions endpoint, for dispatcher's stage-2 enrichment (design
# doc §7). Unset means stage 2 is skipped entirely -- offgrid's normal
# state. See services/dispatcher/README.md.
DISPATCHER_LITELLM_BASE_URL=
DISPATCHER_LITELLM_API_KEY=

# Model name sent in the /chat/completions request. Whatever the endpoint
# above routes -- a LiteLLM proxy's model alias, or a provider model name
# when pointing straight at an OpenAI-compatible API.
DISPATCHER_LITELLM_MODEL=gpt-4o-mini

# hybrid-only: races stt_worker's local whisper.cpp against a remote
# OpenAI-compatible /v1/audio/transcriptions endpoint on Tier A captures
# (design doc §6, "race, don't chain"). Leave STT_CHAIN=local (the
# default) off-grid. See services/stt_worker/README.md.
STT_CHAIN=local
STT_WORKER_REMOTE_BASE_URL=
STT_WORKER_REMOTE_API_KEY=

# Model name sent as the `model` form field on /v1/audio/transcriptions.
# `whisper-1` is the OpenAI-compatible default; a self-hosted
# faster-whisper-server or LiteLLM route may name its models differently
# (e.g. Systran/faster-whisper-large-v3).
STT_WORKER_REMOTE_MODEL=whisper-1
