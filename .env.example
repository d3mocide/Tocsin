# Copy to .env and edit. All variables have defaults except POSTGRES_PASSWORD.


# ── Core ────────────────────────────────────────────────────────────────

# offgrid: no network dependencies. hybrid: enables NWS polling, remote STT, LLM enrichment, MQTT fallback.
TOCSIN_MODE=offgrid

# Required. Set before first start (Postgres locks this on volume init).
POSTGRES_PASSWORD=changeme

# Active compose files. Each overlay maps one piece of hardware into a
# container, and Docker refuses to start a container whose `devices:` host path
# is missing -- so an overlay is present here only when that hardware is:
#   compose.sdr.yaml   RTL-SDR dongle (maps the host USB bus into sdr-rx)
#   compose.mesh.yaml  Meshtastic node (maps its serial port into dispatcher)
# Drop compose.mesh.yaml to run receive-only. Dropping compose.sdr.yaml only
# affects bare `docker compose` calls: `make up-offgrid`/`make up-hybrid` are
# deployment modes and re-add it, since a station with no SDR receives nothing.
# `make dev-stack` is the hardware-free path and ignores this line entirely.
COMPOSE_FILE=compose.yaml:compose.sdr.yaml:compose.mesh.yaml


# ── Ports ───────────────────────────────────────────────────────────────

# Web UI and REST API port on host.
TOCSIN_WEB_PORT=8080

# Icecast audio stream host port (must be > 1024).
ICECAST_PORT=8000

# Optional public URL if Icecast is behind a reverse proxy (default: same host).
ICECAST_PUBLIC_URL=

# Internal bind port for API container (rarely changed).
API_PORT=8000


# ── Radio ───────────────────────────────────────────────────────────────

# RTL-SDR dongles as site:serial,site2:serial2 (run `make sdr-devices` to list).
SDR_RX_DEVICES=

# Manual SDR gain in dB. Raise if SAME fails to decode; lower if spectrum saturates.
SDR_RX_GAIN_DB=30

# Squelch threshold (dB) for live Icecast audio (does not affect SAME decode).
SDR_RX_SQUELCH_OPEN_DB=8.0

# Comma-separated NWR channels to stream (e.g. WX5,WX7). Blank = stream all 7.
LIVE_AUDIO_CHANNELS=

# Icecast source password (must match deploy/icecast/icecast.xml).
ICECAST_SOURCE_PASSWORD=hackme

# Optional location in decimal degrees (adds station distance calculation to UI).
TOCSIN_LATITUDE=
TOCSIN_LONGITUDE=


# ── Transcription ───────────────────────────────────────────────────────

# GGML model file in ./models/ (download via `make fetch-models`).
STT_WORKER_MODEL_FILE=ggml-base.en.bin

# Initial prompt for local place/county names to help whisper.cpp with proper nouns.
STT_WORKER_INITIAL_PROMPT=


# ── Meshtastic ──────────────────────────────────────────────────────────

# Transport: serial (USB) or tcp (LAN node).
MESHTASTIC_TRANSPORT=serial

# Host serial device path for USB transport (mapped via compose.mesh.yaml).
MESHTASTIC_SERIAL_DEVICE=/dev/ttyUSB0

# TCP host and port for LAN node transport.
MESHTASTIC_TCP_HOST=
MESHTASTIC_TCP_PORT=4403


# ── Hybrid only (ignored under TOCSIN_MODE=offgrid) ─────────────────────

# User-Agent required by NWS API (e.g. 'tocsin (youremail@example.com)').
NWS_POLLER_USER_AGENT=tocsin (youremail@example.com)

# States/marine areas to poll (e.g. OR,WA). Leave blank if using NWS_POLLER_ZONES.
NWS_POLLER_AREAS=OR,WA

# NWS forecast zone codes (e.g. ORZ006,ORZ005). If NWS_POLLER_AREAS is blank, polls only these.
NWS_POLLER_ZONES=

# Set true to discard polled alerts that do not affect NWS_POLLER_ZONES.
NWS_POLLER_STRICT_ZONE_FILTER=false

# STT pipeline: local, local,remote, or remote.
STT_CHAIN=local
STT_WORKER_REMOTE_BASE_URL=
STT_WORKER_REMOTE_API_KEY=
STT_WORKER_REMOTE_MODEL=whisper-1

# Stage 2 LLM alert enrichment endpoint (OpenAI / LiteLLM compatible).
DISPATCHER_LITELLM_BASE_URL=
DISPATCHER_LITELLM_API_KEY=
DISPATCHER_LITELLM_MODEL=gpt-4o-mini

# Decimal node ID for MQTT mesh relay fallback.
MESHTASTIC_GATEWAY_NODE_ID=
