# Copy to .env and edit. All variables have defaults except POSTGRES_PASSWORD.


# ── Core ────────────────────────────────────────────────────────────────

# offgrid: no network dependencies. hybrid: enables NWS polling, remote STT, LLM enrichment.
TOCSIN_MODE=offgrid

# Required. Set before first start (Postgres locks this on volume init).
POSTGRES_PASSWORD=changeme

# Compose overlays to load. Drop compose.mesh.yaml to run receive-only
# (no Meshtastic node). compose.sdr.yaml maps the RTL-SDR's USB bus;
# `make dev-stack` ignores this line and runs hardware-free regardless.
COMPOSE_FILE=compose.yaml:compose.sdr.yaml:compose.mesh.yaml


# ── Ports ───────────────────────────────────────────────────────────────

# Web UI and REST API port on host.
TOCSIN_WEB_PORT=8080

# Icecast audio stream host port (must be > 1024).
ICECAST_PORT=8000

# Where the browser reaches Icecast. Unset = same host as ICECAST_PORT.
# Absolute URL if Icecast has its own address behind the proxy, or a
# relative path (e.g. /stream) to proxy audio through api itself instead.
ICECAST_PUBLIC_URL=

# Internal bind port for API container (rarely changed).
API_PORT=8000

# Browser origins allowed to read the API cross-origin. "*" is fine for
# localhost/LAN; set to your real origin(s) once exposed to the internet.
CORS_ALLOWED_ORIGINS=*

# How long (seconds) an expired alert stays in the feed before it's pruned.
ALERTS_PRUNE_GRACE_SECONDS=86400


# ── Radio ───────────────────────────────────────────────────────────────

# RTL-SDR dongles as site:serial,site2:serial2 (run `make sdr-devices` to list).
SDR_RX_DEVICES=

# Manual SDR gain in dB. Raise if SAME fails to decode; lower if spectrum saturates.
SDR_RX_GAIN_DB=30

# Squelch threshold (dB) for live Icecast audio (does not affect SAME decode).
SDR_RX_SQUELCH_OPEN_DB=8.0

# Comma-separated NWR channels to stream (e.g. WX5,WX7). Blank = stream all 7.
LIVE_AUDIO_CHANNELS=

# Icecast source password (live-audio uses this too). Change before exposing past localhost.
ICECAST_SOURCE_PASSWORD=hackme

# Icecast admin UI password. Change before exposing past localhost.
ICECAST_ADMIN_PASSWORD=hackme

# Optional location in decimal degrees (adds station distance calculation to UI).
TOCSIN_LATITUDE=
TOCSIN_LONGITUDE=


# ── Transcription ───────────────────────────────────────────────────────

# GGML model file in ./models/ (download via `make fetch-models`).
STT_WORKER_MODEL_FILE=ggml-base.en.bin

# Initial prompt for local place/county names to help whisper.cpp with proper nouns.
STT_WORKER_INITIAL_PROMPT=

# Continuously transcribe one NWR channel for hazard keywords (data/keyword_triggers.yaml).
# Extra CPU; matches appear as TRANSCRIPT_ONLY alerts in the UI, never on the mesh.
LIVE_TRANSCRIPTION_ENABLED=false

# Site name from SDR_RX_DEVICES (e.g. "PDX"), and channel (e.g. WX5). Both required.
LIVE_TRANSCRIPTION_SITE=
LIVE_TRANSCRIPTION_CHANNEL=

# Speech/silence RMS threshold. Tune via the status log line segment-capture prints.
LIVE_TRANSCRIPTION_RMS_THRESHOLD=0.02

# Chunk duration bounds and silence hang time (seconds).
LIVE_TRANSCRIPTION_MIN_CHUNK_SECONDS=3
LIVE_TRANSCRIPTION_MAX_CHUNK_SECONDS=20
LIVE_TRANSCRIPTION_SILENCE_HANG_SECONDS=1

# Interval (seconds) for the level/chunk status log line.
LIVE_TRANSCRIPTION_STATUS_INTERVAL_SECONDS=300

# Allow continuous ambient audio chunks to be sent to remote STT when STT_CHAIN=remote.
LIVE_TRANSCRIPTION_ALLOW_REMOTE=false


# ── Meshtastic ──────────────────────────────────────────────────────────

# Transport: serial (USB) or tcp (LAN node).
MESHTASTIC_TRANSPORT=serial

# Host serial device path for USB transport (mapped via compose.mesh.yaml).
MESHTASTIC_SERIAL_DEVICE=/dev/ttyUSB0

# TCP host and port for LAN node transport.
MESHTASTIC_TCP_HOST=
MESHTASTIC_TCP_PORT=4403

# Channel index to send on (0-7). Blank = node's Primary channel.
MESHTASTIC_CHANNEL_INDEX=


# ── Hybrid only (ignored under TOCSIN_MODE=offgrid) ─────────────────────

# User-Agent required by NWS API (e.g. 'tocsin (youremail@example.com)').
NWS_POLLER_USER_AGENT=tocsin (youremail@example.com)

# States/marine areas to poll (e.g. OR,WA). Leave blank if using NWS_POLLER_ZONES.
NWS_POLLER_AREAS=OR,WA

# NWS forecast zone codes (e.g. ORZ006,ORZ005). If NWS_POLLER_AREAS is blank, polls only these.
NWS_POLLER_ZONES=

# Set true to discard polled alerts that do not affect NWS_POLLER_ZONES.
NWS_POLLER_STRICT_ZONE_FILTER=false

# Max geographic radius in miles around TOCSIN_LATITUDE/LONGITUDE to monitor (e.g. 100).
# Alerts outside this distance from operator coordinates are automatically dropped.
NWS_POLLER_MAX_RADIUS_MILES=100

# STT pipeline: local, local,remote, or remote.
STT_CHAIN=local
STT_WORKER_REMOTE_BASE_URL=
STT_WORKER_REMOTE_API_KEY=
STT_WORKER_REMOTE_MODEL=whisper-1

# Stage 2 LLM alert enrichment endpoint (OpenAI / LiteLLM compatible).
DISPATCHER_LITELLM_BASE_URL=
DISPATCHER_LITELLM_API_KEY=
DISPATCHER_LITELLM_MODEL=gpt-4o-mini
